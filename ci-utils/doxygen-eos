#
# Publish the Doxygen documentation of Gaudi on EOSWEB as SquashFS images.
#
# For each documentation version NAME (a tag, or "master"), the HTML files are
# packed in a SquashFS image stored (hidden) in EOS as
#
#   $EOS_PATH/doxygen/.squashfs/.NAME.sqsh
#
# and EOSWEB serves it thanks to a symlink
#
#   $EOS_PATH/doxygen/NAME -> /eos/squashfs/<EOS instance>@<path of the image>
#
# (see https://eos-docs.web.cern.ch/using/squashfs.html). The list of the
# available versions is published as static files, $EOS_PATH/doxygen/index.html
# and $EOS_PATH/doxygen/list.txt (one name per line), so that no PHP is needed.
#
# Usage:
#
#   doxygen-eos pack HTML_DIR IMAGE
#       create the SquashFS IMAGE from the content of HTML_DIR
#
#   doxygen-eos deploy NAME IMAGE
#       publish IMAGE as the documentation NAME, replacing any previous version,
#       and update the list of versions
#
#   doxygen-eos listing
#       only update the list of versions
#
#   doxygen-eos index DIR
#       write the list of versions (index.html and list.txt) for the
#       documentations found in the local directory DIR, e.g. to test the
#       website locally (no access to EOS needed)
#
# The commands that access EOS (deploy and listing) need:
#  - EOS_PATH: the EOS directory of the website (the Doxygen documentation is
#    in its "doxygen" subdirectory),
#  - a Kerberos ticket, or EOS_ACCOUNT_USERNAME and EOS_ACCOUNT_PASSWORD (the
#    same variables used by the GitLab-CI "deploy-eos" tool) to get one,
#  - optionally EOS_MGM_URL, if it cannot be deduced from EOS_PATH.

set -euo pipefail

die() {
    echo "error: $*" >&2
    exit 1
}

usage() {
    sed -n '/^# Usage:/,/^# The commands/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
    exit 2
}

# Set up everything needed to talk to EOS.
eos_setup() {
    [ -n "${EOS_PATH:-}" ] || die "EOS_PATH must be set"
    DOXYGEN_DIR=${EOS_PATH%/}/doxygen
    IMAGES_DIR=$DOXYGEN_DIR/.squashfs

    if [ -z "${EOS_MGM_URL:-}" ]; then
        if [[ $EOS_PATH =~ ^/eos/project/([a-z])/ ]]; then
            EOS_MGM_URL=root://eosproject-${BASH_REMATCH[1]}.cern.ch/
        else
            die "cannot deduce EOS_MGM_URL from EOS_PATH=$EOS_PATH, please set it"
        fi
    fi
    export EOS_MGM_URL
    # host name of the EOS instance, as used in the /eos/squashfs symlinks
    MGM_HOST=${EOS_MGM_URL#*://}
    MGM_HOST=${MGM_HOST%%[:/]*}

    if ! klist -s 2>/dev/null; then
        [ -n "${EOS_ACCOUNT_USERNAME:-}" ] && [ -n "${EOS_ACCOUNT_PASSWORD:-}" ] ||
            die "a Kerberos ticket or EOS_ACCOUNT_USERNAME and EOS_ACCOUNT_PASSWORD are needed"
        local user=$EOS_ACCOUNT_USERNAME
        [[ $user == *@* ]] || user=$user@CERN.CH
        kinit "$user" <<<"$EOS_ACCOUNT_PASSWORD" >/dev/null
    fi
}

cmd_pack() {
    [ $# -eq 2 ] || usage
    local html_dir=$1 image=$2
    if [ ! -e "$html_dir/index.html" ]; then
        echo "error: $html_dir does not look like Doxygen HTML output" >&2
        return 1
    fi
    # the image is read by a different user, so we must not rely on our umask
    chmod -R a+rX "$html_dir"
    PATH=$PATH:/usr/sbin:/sbin mksquashfs "$html_dir" "$image" -noappend -all-root -quiet -no-progress
}

# publish_image NAME IMAGE: upload IMAGE and make it visible as DOXYGEN_DIR/NAME
publish_image() {
    local name=$1 image=$2
    local remote_image=$IMAGES_DIR/.$name.sqsh
    echo "publishing $name ($image)"
    eos mkdir -p "$IMAGES_DIR"
    eos cp "$(realpath "$image")" "$remote_image"
    # the link must be (re)created, in case it was a plain directory
    eos rm -r "$DOXYGEN_DIR/$name" 2>/dev/null || true
    eos file symlink "$DOXYGEN_DIR/$name" "/eos/squashfs/$MGM_HOST@${remote_image//\//---}"
}

# write_listing DIR: write the static list of versions (index.html and list.txt)
# in DIR, from the names of the versions (one per line) read from the standard
# input: most recent first, with "master" on top.
write_listing() {
    local dir=$1 names
    names=$(grep -v -x -e index.html -e list.txt || true)
    {
        grep -x master <<<"$names" || true
        grep -v -x master <<<"$names" | sort -rV || true
    } >"$dir/list.txt"
    {
        echo '<!DOCTYPE html>'
        echo '<html>'
        echo '<head><title>Available Gaudi Doxygen documentations</title></head>'
        echo '<body>'
        echo '<h1>Gaudi Doxygen documentation available for the following versions:</h1>'
        echo '<ul>'
        while read -r name; do
            echo "<li><a href=\"$name/index.html\">$name</a></li>"
        done <"$dir/list.txt"
        echo '</ul>'
        echo '</body>'
        echo '</html>'
    } >"$dir/index.html"
}

# Regenerate the list of versions published in EOS.
update_listing() {
    local tmp
    tmp=$(mktemp -d)
    eos ls "$DOXYGEN_DIR" | write_listing "$tmp"
    eos cp "$tmp/list.txt" "$DOXYGEN_DIR/list.txt"
    eos cp "$tmp/index.html" "$DOXYGEN_DIR/index.html"
    rm -rf "$tmp"
}

cmd_deploy() {
    [ $# -eq 2 ] || usage
    eos_setup
    publish_image "$1" "$2"
    update_listing
}

cmd_listing() {
    [ $# -eq 0 ] || usage
    eos_setup
    update_listing
}

cmd_index() {
    [ $# -eq 1 ] || usage
    ls "$1" | write_listing "$1"
}

cmd=${1:-}
shift || true
case $cmd in
    pack) cmd_pack "$@" ;;
    deploy) cmd_deploy "$@" ;;
    listing) cmd_listing "$@" ;;
    index) cmd_index "$@" ;;
    *) usage ;;
esac
